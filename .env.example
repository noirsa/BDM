MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=adminminio
MINIO_SECRET_KEY=adminminio
MINIO_HOST=minio
MINIO_WRITER_ACCESS_KEY=bdm_writer
MINIO_WRITER_SECRET_KEY=bdm_writer_password
MINIO_READER_ACCESS_KEY=bdm_reader
MINIO_READER_SECRET_KEY=bdm_reader_password
OPENAQ_API_KEY=<YOUR_OPENAQ_TOKEN>
AIRFLOW_UID=50000
LOG_LEVEL=2
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_MASTER_UI_URL=http://spark-master:8080/json/
CONSUMPTION_DASHBOARD_NOTEBOOK_PATH=/opt/airflow/notebooks/Consumption Zone/2. spark_streaming_with_kafka_dash.ipynb
CONSUMPTION_DASHBOARD_SCRIPT_PATH=/opt/airflow/scripts/consumption_streaming_dashboard.py
CONSUMPTION_DASHBOARD_CHECKPOINT_LOCATION=/opt/airflow/logs/checkpoints/consumption_streaming_dashboard/weather
CONSUMPTION_DASHBOARD_LOG_PATH=/opt/airflow/logs/consumption_streaming_dashboard.log
DASHBOARD_SPARK_APP_NAME=consumption_streaming_dashboard
DASHBOARD_POSTGRES_JDBC_URL=jdbc:postgresql://postgres-analytics:5432/analytics
DASHBOARD_POSTGRES_TABLE=weather_events
DASHBOARD_POSTGRES_USER=superset
DASHBOARD_POSTGRES_PASSWORD=superset
AIRFLOW_CONN_AWS_DEFAULT=aws://bdm_writer:bdm_writer_password@/?endpoint_url=http%3A%2F%2Fminio%3A9000&addressing_style=path

# Optional Trusted Zone RBAC service credentials.
# Existing admin/root/analytics credentials remain valid maintenance fallbacks.
CLICKHOUSE_TRUSTED_USER=trusted_structured_writer
CLICKHOUSE_TRUSTED_PASSWORD=trusted_structured_writer_password
CLICKHOUSE_CONSUMPTION_USER=consumption_service
CLICKHOUSE_CONSUMPTION_PASSWORD=consumption_service_password
MONGODB_TRUSTED_USER=trusted_semistructured_writer
MONGODB_TRUSTED_PASSWORD=trusted_semistructured_writer_password
MONGODB_TRUSTED_URI=mongodb://trusted_semistructured_writer:trusted_semistructured_writer_password@mongo:27017/trusted_zone_semi-structured

# Milvus RBAC. Root is preserved for maintenance; service users are used by
# image vectorization and search/consumption paths when available.
MILVUS_URI=http://milvus:19530
MILVUS_ROOT_USER=root
MILVUS_ROOT_PASSWORD=Milvus
MILVUS_WRITER_USER=bdm_vector_writer
MILVUS_WRITER_PASSWORD=bdm_vector_writer_password
MILVUS_READER_USER=bdm_vector_reader
MILVUS_READER_PASSWORD=bdm_vector_reader_password
MILVUS_IMAGE_COLLECTION=image_vector_catalog
